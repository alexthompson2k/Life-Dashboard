# ---------------------------------------------------------------------------
# Frontend environment. Copy to .env.local and fill in.
#
# Anything prefixed VITE_ is bundled into the browser build, so ONLY put
# publishable keys here. The Supabase anon key is designed to be public — row
# level security is what protects your data. Never put a service-role key or
# a Plaid secret in this file.
# ---------------------------------------------------------------------------

# Leave both blank to run the dashboard on local sample data with no account.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: point the frontend at an API server on a different origin.
# Leave blank in development — the Vite dev server proxies /api for you.
VITE_API_BASE_URL=
