# ---------------------------------------------------------------------------
# API server environment. Copy to server/.env and fill in.
#
# These values stay on the server and are never shipped to the browser.
# ---------------------------------------------------------------------------

PORT=8787

# --- Plaid -----------------------------------------------------------------
# From https://dashboard.plaid.com/developers/keys
# Start with the sandbox environment; use the test credentials
# user_good / pass_good in Plaid Link.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US

# --- Supabase (service role) ------------------------------------------------
# Needed for the daily brief, which reads your data server-side to compose the
# notification. This key bypasses row-level security — keep it server-side and
# never prefix it with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Daily brief (Web Push) -------------------------------------------------
# Generate a key pair once with:
#   npx web-push generate-vapid-keys
# The public key is served to the browser; the private key must stay here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
